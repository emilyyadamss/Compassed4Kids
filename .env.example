# The browser's half. Anything named VITE_* is compiled into the JavaScript
# your users download, so only ever put public values here. The Supabase anon
# key is public by design — row level security is what protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The server's half, used only by api/quiz.js. These are NOT prefixed, which
# is what keeps them out of the bundle. On Vercel, set them under
# Project → Settings → Environment Variables rather than committing them.

# Your Claude API key, from console.anthropic.com. Quizzes are the only thing
# that uses it; leave it unset and the rest of the app works exactly as before.
ANTHROPIC_API_KEY=sk-ant-...

# The same Supabase project as above, so the endpoint can check that whoever is
# asking for a quiz is a signed-in family and not the open internet.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional. Answer keys are sealed with this before being handed to the
# browser. Unset, it is derived from ANTHROPIC_API_KEY — set it explicitly if
# you would rather rotating your Claude key did not also invalidate quizzes
# that are open on a tablet at that moment. Any long random string.
# QUIZ_SECRET=
